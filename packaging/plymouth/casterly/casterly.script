// Casterly Pulse — Plymouth boot splash script
//
// Deliberately minimal: a solid dark-navy background (matching the app's own
// "Command Center" theme, #0a1626) with the Casterly Pulse logo centered on
// it, plus one line of status text. No Ubuntu logo, no progress bar, no
// spinner artwork — this is the only thing a technician should ever see
// between power-on and the Pulse UI.
//
// logo.png is the pulse_logo.png lockup composited onto a white rounded
// plate (see packaging/README.md for how it was generated), so it reproduces
// the exact same white-plate treatment the app's own header uses.

Window.SetBackgroundTopColor(0.039, 0.086, 0.149);
Window.SetBackgroundBottomColor(0.039, 0.086, 0.149);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_x = Window.GetWidth()  / 2 - logo_image.GetWidth()  / 2;
logo_y = Window.GetHeight() / 2 - logo_image.GetHeight() / 2;
logo_sprite.SetX(logo_x);
logo_sprite.SetY(logo_y);
logo_sprite.SetZ(10000);

status_image = Image.Text("Preparing inspection environment", 0.58, 0.65, 0.75);
status_sprite = Sprite(status_image);
status_sprite.SetX(Window.GetWidth() / 2 - status_image.GetWidth() / 2);
status_sprite.SetY(logo_y + logo_image.GetHeight() + 36);
status_sprite.SetZ(10000);

// Required by the script plugin even if unused — keeps Plymouth quiet
// instead of falling back to a text console if a callback is missing.
fun refresh_callback() {
}
Plymouth.SetRefreshFunction(refresh_callback);
