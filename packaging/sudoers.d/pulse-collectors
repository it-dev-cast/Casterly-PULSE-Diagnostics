# PULSE 4.0 — passwordless sudo for hardware collectors
#
# Allows the application to run its privileged read-only hardware collectors
# without an interactive password prompt. install.sh copies this file in
# automatically; the manual steps below are only needed if you're installing
# it by hand instead:
#
#   sudo cp pulse-collectors /etc/sudoers.d/pulse-collectors
#   sudo chown root:root      /etc/sudoers.d/pulse-collectors
#   sudo chmod 0440           /etc/sudoers.d/pulse-collectors
#   sudo visudo -cf /etc/sudoers.d/pulse-collectors   # validate syntax
#
# "ubuntu" below matches AUTOLOGIN_USER in install.sh and User= in
# casterly-pulse.service. If you ever rename that account, update all three
# in lockstep. (To grant to every sudo-group user instead, use "%sudo".)

Cmnd_Alias PULSE_HW = /usr/sbin/dmidecode, /usr/bin/dmidecode, \
                      /usr/sbin/smartctl, /usr/bin/smartctl, \
                      /usr/sbin/nvme,     /usr/bin/nvme

# Lets the header's power-off button shut the machine down without an
# interactive polkit password prompt (which could otherwise be stranded
# behind the app's always-on-top kiosk window). Args are pinned exactly to
# "-h now" so this can't be used to run arbitrary root commands.
Cmnd_Alias PULSE_POWER = /usr/sbin/shutdown -h now, /usr/bin/shutdown -h now, \
                         /sbin/shutdown -h now,     /bin/shutdown -h now

ubuntu ALL=(root) NOPASSWD: PULSE_HW, PULSE_POWER
