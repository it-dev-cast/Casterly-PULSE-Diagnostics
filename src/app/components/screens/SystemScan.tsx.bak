
import { useEffect, useState, useRef } from "react";
import {
  useInspection,
} from "../../context/InspectionContext";
let scanAlreadyCompleted = false;
import { invoke } from "@tauri-apps/api/core";
import {
  Cpu,
  MemoryStick,
  HardDrive,
  Battery,
  Wifi,
  Monitor,
  CircuitBoard,
  Server,
  CheckCircle2,
  RefreshCw,
  Speaker,
  Camera,
} from "lucide-react";

interface InfoCardProps {
  icon: React.ElementType;
  title: string;
  items: { label: string; value: string }[];
  status?: "ok" | "warn" | "critical";
}

function InfoCard({ icon: Icon, title, items, status = "ok" }: InfoCardProps) {
  const statusBadge = {
    ok: "bg-emerald-100 text-emerald-700",
    warn: "bg-amber-100 text-amber-700",
    critical: "bg-red-100 text-red-700",
  };

  const statusLabel = {
    ok: "Detected",
    warn: "Warning",
    critical: "Critical",
  };




  return (
    <div className="bg-white rounded-lg border border-slate-200 overflow-hidden">
      <div className="flex items-center justify-between px-4 py-3 bg-slate-50 border-b border-slate-200">
        <div className="flex items-center gap-2.5">
          <Icon size={15} className="text-blue-600" />
          <span className="text-sm text-slate-700">{title}</span>
        </div>

        <span
          className={`text-[10px] px-2 py-0.5 rounded-full ${statusBadge[status]}`}
        >
          {statusLabel[status]}
        </span>
      </div>

      <div className="p-4 space-y-2">
        {items.map((item) => (
          <div
            key={item.label}
            className="flex items-center justify-between"
          >
            <span className="text-xs text-slate-500">
              {item.label}
            </span>

            <span className="text-xs text-slate-800 font-medium text-right max-w-[240px]">
              {item.value}
            </span>
          </div>
        ))}
      </div>
    </div>
  );
}

interface SystemScanProps {
  onNext: () => void;
}

interface SystemInfo {
  manufacturer: string;
  model: string;
  serial_number: string;
  uuid: string;
}

interface CpuInfo {
  manufacturer: string;
  model: string;
  architecture: string;
  sockets: number;
  cores_per_socket: number;
  threads: number;
  max_speed_mhz: number;
  min_speed_mhz: number;
  current_speed_mhz: number;
  cache_l1: string;
  cache_l2: string;
  cache_l3: string;
  virtualization: boolean;
  hyper_threading: boolean;
  flags: string[];
}

interface MemoryModule {
  slot: string;
  bank_locator: string;
  size_mb: number;
  memory_type: string;
  manufacturer: string;
  serial: string;
  part_number: string;
  speed_mhz: number;
  is_empty: boolean;
  is_onboard: boolean;
}

interface StorageDevice {
  device: string;
  model: string;
  serial: string;
  firmware: string;
  size_gb: number;
  transport: string;
  storage_type: string;
  health_percent: number | null;
  temperature_c: number | null;
  power_on_hours: number | null;
}

interface BatteryInfo {
  manufacturer: string;
  model: string;
  serial_number: string;
  technology: string;
  status: string;
  cycle_count: number;
  design_capacity_mwh: number;
  full_charge_capacity_mwh: number;
  current_capacity_mwh: number;
  voltage_mv: number;
}



interface NetworkInfo {
  wifi: string;
  wifi_friendly: string;
  wifi_mac: string;
  ethernet: string;
  ethernet_friendly: string;
  ethernet_mac: string;
  bluetooth: boolean;
}

export function SystemScan({ onNext }: SystemScanProps) {
  const [systemInfo, setSystemInfo] =
    useState<SystemInfo | null>(null);

  const [cpuInfo, setCpuInfo] =
    useState<CpuInfo | null>(null);

  const [memoryInfo, setMemoryInfo] =
  useState<MemoryModule[]>([]);

  const [storageInfo, setStorageInfo] =
  useState<StorageDevice[]>([]);

  const [batteryInfo, setBatteryInfo] =
    useState<BatteryInfo | null>(null);

  const [completedCalls, setCompletedCalls] =
  useState(0);

  const [networkInfo, setNetworkInfo] =
  useState<NetworkInfo | null>(null);

  const autoAdvanced =
  useRef(false);

  const {data, setData,} = useInspection();
//Restoring data from context below block
  useEffect(() => {

  if (!data.scanCompleted) {
    return;
  }

  console.log(
    "RESTORING SCAN FROM CONTEXT"
  );

  setSystemInfo(data.systemInfo);
  setCpuInfo(data.cpuInfo);
  setMemoryInfo(data.memoryInfo || []);
  setStorageInfo(data.storageInfo || []);
  setBatteryInfo(data.batteryInfo);
  setNetworkInfo(data.networkInfo);

  setCompletedCalls(8);

}, []);
//Restoring data from context above block
  const previousScanState =
  useRef(false);
// below code for console output
useEffect(() => {

  console.log(
    "CONTEXT CHANGED:",
    data
  );

}, [data]);

// above code for console output

  useEffect(() => {
      if (data.scanCompleted) {
      console.log(
      "USING CACHED SCAN"
      );
      return;
      }
      if (scanAlreadyCompleted) {
      return;
      }
    scanAlreadyCompleted = true;
    console.log( "RUNNING FRESH SCAN" );

    invoke<SystemInfo>("get_system_info")
      .then((data) => {
        console.log("System Info:", data);
        setSystemInfo(data);
        setData(prev => ({...prev, systemInfo: data,}));
        setCompletedCalls(prev => prev + 1);
      })
      .catch((err) => {
        console.error("System scan failed:", err);

        setSystemInfo({
          manufacturer: "ERROR",
          model: String(err),
          serial_number: "-",
          uuid: "-",
        });
        setCompletedCalls(prev => prev + 1);
      });

    invoke<CpuInfo>("get_cpu_info")
      .then((data) => {
        console.log("CPU INFO:", data);
        setCpuInfo(data);
        setData(prev => ({...prev, cpuInfo: data,}));
        setCompletedCalls(prev => prev + 1);
      })
      .catch((err) => {
        console.error("CPU ERROR:", err);
        setCompletedCalls(prev => prev + 1);
      });

      invoke<BatteryInfo | null>("get_battery_info")
  .then((data) => {
    console.log("BATTERY INFO:", data);

    if (data) {
      setBatteryInfo(data);
    }
    setData(prev => ({...prev, batteryInfo: data,}));
    setCompletedCalls(prev => prev + 1);
  })
  .catch((err) => {
    console.error("BATTERY ERROR:", err);
    setCompletedCalls(prev => prev + 1);
  });
  

      invoke("get_gpu_info")
  .then((data) => {
    console.log("GPU INFO:", data);
    setData(prev => ({...prev, gpuInfo: data,}));
    setCompletedCalls(prev => prev + 1);
  })
  .catch((err) => {
    console.error("GPU ERROR:", err);
    setCompletedCalls(prev => prev + 1);
  });

  invoke("get_display_info")
  .then((data) => {
    console.log("DISPLAY INFO:", data);
    setData(prev => ({...prev, displayInfo: data,}));
    setCompletedCalls(prev => prev + 1);
  })
  .catch((err) => {
    console.error("DISPLAY ERROR:", err);
    setCompletedCalls(prev => prev + 1);
  });

  invoke<NetworkInfo>(
  "get_network_info"
)
.then((data) => {

  console.log(
    "NETWORK INFO:",
    data
  );

  setNetworkInfo(data);
  setData(prev => ({...prev, networkInfo: data,}));
  setCompletedCalls(prev => prev + 1);
})
  .catch((err) => {
    console.error("NETWORK ERROR:", err);
    setCompletedCalls(prev => prev + 1);
  });


      invoke<MemoryModule[]>("get_memory_info")
  .then((data) => {
    console.log("MEMORY INFO:", data);
    setMemoryInfo(data);
    setData(prev => ({...prev, memoryInfo: data,}));
    setCompletedCalls(prev => prev + 1);
  })
  .catch((err) => {
    console.error("MEMORY ERROR:", err);
    setCompletedCalls(prev => prev + 1);
  });

  invoke<StorageDevice[]>("get_storage_info")
  .then((data) => {
    console.log("STORAGE INFO:", data);
    setStorageInfo(data);
    setData(prev => ({...prev, storageInfo: data,
    scanCompleted: true,
    }));
    setCompletedCalls(prev => prev + 1);
    
  })
  .catch((err) => {
    console.error("STORAGE ERROR:", err);
    setCompletedCalls(prev => prev + 1);
  });

  }, []);

useEffect(() => {

  if (
    completedCalls >= 8 &&
    !autoAdvanced.current
  ) {

    autoAdvanced.current = true;

    console.log(
      "SYSTEM SCAN COMPLETE"
    );

    onNext();
  }

}, [completedCalls, onNext]);

const totalMemoryGb =
  memoryInfo.reduce(
    (sum, m) => sum + m.size_mb,
    0
  ) / 1024;

const populatedSlots =
  memoryInfo.filter(
    (m) => !m.is_empty
  ).length;

const firstMemory =
  memoryInfo.find(
    (m) => !m.is_empty
  );

const primaryDrive =
  storageInfo.length > 0
    ? storageInfo[0]
    : null;

const onboardMemory =
  memoryInfo.every(
    (m) => m.is_onboard
  );

const firstModule =
  memoryInfo[0];



  return (
    <div className="space-y-5">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-slate-800">
            System Scan
          </h1>

          <p className="text-sm text-slate-500 mt-0.5">
            Automated hardware detection and diagnostics
          </p>
        </div>

        <div className="flex items-center gap-3">
          <button
           onClick={() => {
           scanAlreadyCompleted = false;
           window.location.reload();
           }}
           className="flex items-center gap-2 text-sm text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 px-3 py-2 rounded-lg transition-colors">
            <RefreshCw size={14} />
            Re-scan
          </button>

          <div className="flex items-center gap-1.5 text-xs bg-emerald-50 border border-emerald-200 text-emerald-700 px-3 py-1.5 rounded-lg">
  <CheckCircle2 size={13} />

  {completedCalls >= 8
    ? "Scan Complete - Auto advancing..."
    : `Scanning... ${completedCalls}/8`}
</div>
        </div>
      </div>

      <div className="grid grid-cols-5 gap-4">
        <InfoCard
          icon={Server}
          title="System"
          items={[
            {
              label: "Manufacturer",
              value:
                systemInfo?.manufacturer ||
                "Scanning...",
            },
            {
              label: "Model",
              value:
                systemInfo?.model ||
                "Scanning...",
            },
            {
              label: "Serial Number",
              value:
                systemInfo?.serial_number ||
                "Scanning...",
            },
            {
              label: "UUID",
              value:
                systemInfo?.uuid ||
                "Scanning...",
            },
          ]}
        />

        <InfoCard
          icon={Cpu}
          title="CPU"
          items={[
            {
              label: "Processor",
              value:
                cpuInfo?.model ||
                "Scanning...",
            },
            {
              label: "Vendor",
              value:
                cpuInfo?.manufacturer ||
                "Scanning...",
            },
            {
              label: "Cores",
              value: cpuInfo
                ? `${cpuInfo.cores_per_socket}`
                : "Scanning...",
            },
            {
              label: "Threads",
              value: cpuInfo
                ? `${cpuInfo.threads}`
                : "Scanning...",
            },
          ]}
        />

        <InfoCard
  icon={MemoryStick}
  title="Memory"
  items={[
    {
  label: "Installed",
  value:
    memoryInfo.length > 0
      ? `${totalMemoryGb} GB`
      : "Scanning...",
},
{
  label: "Type",
  value:
    firstModule?.memory_type ||
    "Scanning...",
},
{
  label: "Speed",
  value:
    firstModule
      ? `${firstModule.speed_mhz} MT/s`
      : "Scanning...",
},
{
  label: "Topology",
  value:
    onboardMemory
      ? "Onboard"
      : `${populatedSlots} Used`,
},
  ]}
/>

        <InfoCard
  icon={HardDrive}
  title="Storage"
  items={[
    {
  label: "Type",
  value:
    primaryDrive?.storage_type ||
    "Scanning...",
},
{
  label: "Model",
  value:
    primaryDrive?.model ||
    "Scanning...",
},
{
  label: "Serial",
  value:
    primaryDrive?.serial ||
    "Scanning...",
},
{
  label: "Capacity",
  value:
    primaryDrive
      ? `${primaryDrive.size_gb.toFixed(0)} GB`
      : "Scanning...",
},
  ]}
/>

        <InfoCard
  icon={Battery}
  title="Battery"
  status="ok"
  items={[
    {
      label: "Health",
      value:
        batteryInfo
          ? `${Math.round(
              (batteryInfo.full_charge_capacity_mwh /
                batteryInfo.design_capacity_mwh) *
                100
            )}%`
          : "Scanning...",
    },
    {
      label: "Capacity",
      value:
  batteryInfo
    ? `${(
        batteryInfo.current_capacity_mwh / 1000
      ).toFixed(0)} / ${(
        batteryInfo.full_charge_capacity_mwh / 1000
      ).toFixed(0)} Wh`
    : "Scanning...",
    },
    {
      label: "Cycle Count",
      value:
        batteryInfo
          ? batteryInfo.cycle_count.toString()
          : "Scanning...",
    },
    {
      label: "Status",
      value:
        batteryInfo?.status ||
        "Scanning...",
    },
  ]}
/>
        
      </div>

      <div className="grid grid-cols-5 gap-4 mt-4">
        <InfoCard
          icon={Monitor}
          title="Display"
          items={[
            { label: "Size", value: "14 inch" },
            { label: "Resolution", value: "1920 × 1080" },
            { label: "Type", value: "FHD IPS" },
            { label: "Refresh", value: "60 Hz" },
          ]}
        />

        <InfoCard
          icon={CircuitBoard}
          title="GPU"
          items={[
            { label: "Graphics", value: "Intel Iris Xe" },
            { label: "VRAM", value: "Shared 8 GB" },
            { label: "Driver", value: "31.0.101.5445" },
            { label: "Output", value: "1920×1080" },
          ]}
        />

        <InfoCard
          icon={Wifi}
          title="Network"
          items={[
  {
    label: "WiFi",
    value:
      networkInfo?.wifi_friendly ||
      "Scanning...",
  },

  {
    label: "WiFi MAC",
    value:
      networkInfo?.wifi_mac ||
      "N/A",
  },

  {
    label: "LAN",
    value:
      networkInfo?.ethernet_friendly ||
      "Not Present",
  },

  {
    label: "LAN MAC",
    value:
      networkInfo?.ethernet_mac ||
      "Not Present",
  },

  {
    label: "Bluetooth",
    value:
      networkInfo?.bluetooth
        ? "Yes"
        : "No",
  },
]}
        />

        <InfoCard
          icon={Speaker}
          title="Audio"
          items={[
            { label: "Speakers", value: "Stereo" },
            { label: "Codec", value: "Realtek ALC" },
            { label: "Jack", value: "3.5mm Combo" },
            { label: "Mic", value: "Built-in" },
          ]}
        />

        <InfoCard
          icon={Camera}
          title="Camera"
          items={[
            { label: "Webcam", value: "HP TrueVision" },
            { label: "Resolution", value: "720p HD" },
            { label: "Privacy", value: "Shutter" },
            { label: "Status", value: "Detected" },
          ]}
        />
      </div>
    </div>
  );
}

